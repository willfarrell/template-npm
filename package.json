{
	"name": "@willfarrell/template-npm",
	"version": "0.0.1",
	"description": "Repository template for npm packages",
	"private": false,
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"engineStrict": true,
	"files": [
		"index.js"
	],
	"main": "index.js",
	"exports": {
		".": {
			"import": {
				"default": "./index.js"
			}
		}
	},
	"scripts": {
		"prepare": "husky",
		"git:pre-commit": "npm run git:test",
		"git:commit-msg": "commitlint --config commitlint.config.cjs --edit",
		"git:test": "npm run git:lint-staged && npm run git:unit-staged",
		"git:lint-staged": "npm run test:lint",
		"git:unit-staged": "node --test",
		"lint": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
		"test": "npm run test:lint && npm run test:unit && npm run test:mutation && npm run test:sast && npm run test:bench && npm run test:dast",
		"test:lint": "biome check --staged --no-errors-on-unmatched --files-ignore-unknown=true",
		"test:unit": "node --test --experimental-test-coverage --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100",
		"test:mutation": "stryker run",
		"test:sast": "npm run test:sast:license && npm run test:sast:lockfile && npm run test:sast:semgrep && npm run test:sast:trufflehog && npm run test:sast:gitleaks && npm run test:sast:actionlint && npm run test:sast:zizmor && npm run test:sast:trivy",
		"test:sast:actionlint": "actionlint -ignore 'configuration variable name \"github_project_number\" must not start with the GITHUB_ prefix'",
		"test:sast:gitleaks": "npm run test:sast:gitleaks:dir && npm run test:sast:gitleaks:git",
		"test:sast:gitleaks:dir": "gitleaks dir . --redact --no-banner",
		"test:sast:gitleaks:git": "gitleaks git . --redact --no-banner",
		"test:sast:license": "node .github/license.mjs check",
		"test:sast:lockfile": "lockfile-lint --path package-lock.json --type npm --allowed-hosts npm --validate-https",
		"test:sast:semgrep": "semgrep scan --config auto --error",
		"test:sast:trivy": "trivy fs --scanners vuln --include-dev-deps --exit-code 1 --skip-files '**/bun.lock' --disable-telemetry . && trivy fs --config .github/trivy.yml --include-dev-deps --skip-files '**/bun.lock' --disable-telemetry .",
		"test:sast:trufflehog": "trufflehog filesystem --only-verified --log-level=-1 ./",
		"test:sast:zizmor": "zizmor .github",
		"test:bench": "node --experimental-bench --bench './**/*.bench.js'",
		"test:dast": "npm run test:dast:fuzz && npm run test:dast:zap",
		"test:dast:fuzz": "node --test ./**/*.fuzz.js",
		"rm": "npm run rm:macos && npm run rm:node_modules && npm run rm:lock",
		"rm:macos": "find . -name '.DS_Store' -type f -delete",
		"rm:lock": "find . -name 'package-lock.json' -type f -delete",
		"rm:node_modules": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
		"test:dast:zap": "",
		"release:license:add": "node .github/license.mjs add",
		"release:license:remove": "node .github/license.mjs remove",
		"release:tag": "git tag -s -m $npm_package_version $npm_package_version",
		"release:staged": "npm whoami >/dev/null && npm stage list $(npm pkg get name | tr -d '\"') --json | jq -r '.[] | \"\\(.packageName)@\\(.version) \\(.actor) \\(.shasum)\"'",
		"release:approve": "npm stage list $(npm pkg get name | tr -d '\"') --json | jq -r --arg v \"$npm_package_version\" '.[] | select(.version == $v) | .id' | xargs -n1 -o npm stage approve"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/willfarrell/template-npm.git"
	},
	"keywords": [],
	"author": "willfarrell",
	"license": "MIT",
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/willfarrell"
	},
	"bugs": {
		"url": "https://github.com/willfarrell/template-npm/issues"
	},
	"homepage": "https://github.com/willfarrell/template-npm",
	"devDependencies": {
		"@biomejs/biome": "^2.5.3",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@stryker-mutator/core": "^9.0.0",
		"fast-check": "^4.9.0",
		"husky": "^9.1.7"
	},
	"overrides": {
		"qs": "^6.15.2"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"onFail": "error"
		},
		"packageManager": {
			"name": "npm",
			"onFail": "error"
		}
	},
	"workspaces": [
		".github"
	]
}
